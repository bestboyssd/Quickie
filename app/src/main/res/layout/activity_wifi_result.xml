<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/wifi_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:fitsSystemWindows="true">

  <!-- Top Back Button -->
  <ImageView
      android:id="@+id/btn_back"
      android:layout_width="48dp"
      android:layout_height="48dp"
      android:layout_marginStart="16dp"
      android:layout_marginTop="16dp"
      android:background="?attr/selectableItemBackgroundBorderless"
      android:contentDescription="Back"
      android:padding="10dp"
      android:src="@drawable/ic_arrow_back"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toTopOf="parent"
      app:tint="#FFFFFF" />

  <!-- Large Result Title -->
  <TextView
      android:id="@+id/tv_title"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginStart="24dp"
      android:layout_marginTop="16dp"
      android:text="Result"
      android:textColor="#FFFFFF"
      android:textSize="34sp"
      android:textStyle="bold"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toBottomOf="@id/btn_back" />

  <!-- Center Card Icon -->
  <FrameLayout
      android:id="@+id/card_result_icon"
      android:layout_width="92dp"
      android:layout_height="92dp"
      android:layout_marginTop="32dp"
      android:background="@drawable/bg_wifi_icon"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toBottomOf="@id/tv_title">

    <ImageView
        android:id="@+id/iv_result_icon"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:contentDescription="@null"
        android:src="@drawable/ic_wifi_large"
        app:tint="#FFFFFF" />

  </FrameLayout>

  <!-- Details Container (Scrollable) -->
  <ScrollView
      android:id="@+id/scroll_details"
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_marginStart="24dp"
      android:layout_marginTop="36dp"
      android:layout_marginEnd="24dp"
      android:layout_marginBottom="16dp"
      android:fillViewport="true"
      app:layout_constraintBottom_toTopOf="@id/bottom_actions_container"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toBottomOf="@id/card_result_icon">

    <LinearLayout
        android:id="@+id/details_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

      <!-- Primary Label & Content (Network name or Text) -->
      <TextView
          android:id="@+id/tv_primary_label"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="Text"
          android:textColor="#8E8E93"
          android:textSize="14sp" />

      <TextView
          android:id="@+id/tv_primary_value"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="8dp"
          android:lineSpacingExtra="4dp"
          android:textIsSelectable="true"
          android:textColor="#FFFFFF"
          android:textSize="16sp"
          android:typeface="monospace"
          tools:text="(_)\n(oo)\n/-----V\n* /\\---/\\\n~~ ~~" />

      <!-- Password Section (for Wi-Fi only) -->
      <LinearLayout
          android:id="@+id/layout_password"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="28dp"
          android:orientation="vertical"
          android:visibility="gone"
          tools:visibility="visible">

        <TextView
            android:id="@+id/tv_password_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Password"
            android:textColor="#8E8E93"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tv_password_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            tools:text="************" />

      </LinearLayout>

      <!-- Secondary Label & Value (e.g. Encryption for Wi-Fi) -->
      <LinearLayout
          android:id="@+id/layout_secondary"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="28dp"
          android:orientation="vertical"
          android:visibility="gone"
          tools:visibility="visible">

        <TextView
            android:id="@+id/tv_secondary_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Encryption"
            android:textColor="#8E8E93"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tv_secondary_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            tools:text="WPA/WPA2" />

      </LinearLayout>

    </LinearLayout>

  </ScrollView>

  <!-- Bottom Actions Container -->
  <LinearLayout
      android:id="@+id/bottom_actions_container"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginStart="24dp"
      android:layout_marginEnd="24dp"
      android:layout_marginBottom="28dp"
      android:orientation="vertical"
      app:layout_constraintBottom_toBottomOf="parent"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toStartOf="parent">

    <!-- Connect button (only visible for Wi-Fi) -->
    <android.widget.Button
        android:id="@+id/btn_connect"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:background="@drawable/bg_connect_button"
        android:text="Connect"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:visibility="gone"
        tools:visibility="visible" />

    <!-- Two-button Stack for Normal Text / QR Scans -->
    <LinearLayout
        android:id="@+id/layout_text_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        tools:visibility="visible">

      <!-- Top Button: Search -->
      <android.widget.Button
          android:id="@+id/btn_search"
          android:layout_width="match_parent"
          android:layout_height="54dp"
          android:background="@drawable/bg_connect_button"
          android:text="Search"
          android:textAllCaps="false"
          android:textColor="#FFFFFF"
          android:textSize="16sp"
          android:textStyle="bold" />

      <!-- Bottom Button: Copy text -->
      <android.widget.Button
          android:id="@+id/btn_copy_text"
          android:layout_width="match_parent"
          android:layout_height="54dp"
          android:layout_marginTop="12dp"
          android:background="@drawable/bg_connect_button"
          android:text="Copy text"
          android:textAllCaps="false"
          android:textColor="#FFFFFF"
          android:textSize="16sp"
          android:textStyle="bold" />

    </LinearLayout>

  </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
